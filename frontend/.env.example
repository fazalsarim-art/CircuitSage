# CircuitSage frontend environment — EXAMPLE / placeholders only.
# Copy to frontend/.env for local development:  Copy-Item frontend/.env.example frontend/.env
#
# WARNING: every VITE_ variable is bundled into the browser build and is therefore PUBLIC.
# NEVER put an API key, password, or connection string in a VITE_ variable.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CircuitSage
