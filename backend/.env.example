# CircuitSage backend environment — EXAMPLE / placeholders only.
# Copy to backend/.env for local development:  Copy-Item backend/.env.example backend/.env
# NEVER commit the real .env. NEVER paste a real secret into an AI prompt, commit, or screenshot.

APP_ENV=development
APP_VERSION=0.1.0

# PostgreSQL (matches the dev credentials in compose.yaml)
DATABASE_URL=postgresql+psycopg://circuitsage:change_me@localhost:5432/circuitsage

# Qdrant (no API key needed for the local container)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=circuitsage_chunks_v1

# OpenAI
# NOTE: OPENAI_CHAT_MODEL below is the spec's placeholder name and must be replaced with a
# real, available model before Phase 5/6 (embeddings + generation).
OPENAI_API_KEY=sk-placeholder
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Auth
JWT_SECRET=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Application config
FRONTEND_ORIGIN=http://localhost:5173
ALLOW_REGISTRATION=true
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=300

# Local cross-encoder reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
